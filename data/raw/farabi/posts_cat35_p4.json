[{"id": 5005, "date": "2024-01-20T11:23:23", "modified": "2024-01-20T12:20:00", "slug": "%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%d8%ab%d8%b4%d8%a7%d9%87%d8%af", "link": "https://help.irfarabi.com/%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%d8%ab%d8%b4%d8%a7%d9%87%d8%af/%d8%a7%d8%ae%d8%a8%d8%a7%d8%b1/%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c/", "title": {"rendered": "زمانبندی پرداخت سود نقدی نماد ثشاهد"}, "content": {"rendered": "\n<p class=\"wp-block-paragraph\">پیرو اطلاعیه منتشر شده در سامانه <strong><a href=\"https://www.codal.ir/ReportList.aspx?search&amp;Symbol=%D8%AB%D8%B4%D8%A7%D9%87%D8%AF&amp;LetterType=-1&amp;Isic=701020&amp;AuditorRef=-1&amp;PageNumber=1&amp;Audited&amp;NotAudited&amp;IsNotAudited=false&amp;Childs&amp;Mains&amp;Publisher=false&amp;CompanyState=0&amp;Category=-1&amp;CompanyType=1&amp;Consolidatable&amp;NotConsolidatable\" data-type=\"link\" data-id=\"https://www.codal.ir/ReportList.aspx?search&amp;Symbol=%D8%AB%D8%B4%D8%A7%D9%87%D8%AF&amp;LetterType=-1&amp;Isic=701020&amp;AuditorRef=-1&amp;PageNumber=1&amp;Audited&amp;NotAudited&amp;IsNotAudited=false&amp;Childs&amp;Mains&amp;Publisher=false&amp;CompanyState=0&amp;Category=-1&amp;CompanyType=1&amp;Consolidatable&amp;NotConsolidatable\">کدال</a></strong>، زمان‌بندی پرداخت سود شرکت شاهد با نماد “ثشاهد” برای سال مالی منتهی به 1402/03/31 به شرح زیر است.</p>\n\n\n\n<p class=\"wp-block-paragraph\">سهامدارانی که در تاریخ 1402/07/24 سهامدار این نماد بوده و در مجمع عمومی عادی شرکت داشته‌اند مشمول دریافت <strong>60 ریال</strong> سود نقدی هستند.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"246\" src=\"https://help.irfarabi.com/wp-content/uploads/2024/01/ثشاهد-1024x246.png\" alt=\"\" class=\"wp-image-5023\" srcset=\"https://help.irfarabi.com/wp-content/uploads/2024/01/ثشاهد-1024x246.png 1024w, https://help.irfarabi.com/wp-content/uploads/2024/01/ثشاهد-300x72.png 300w, https://help.irfarabi.com/wp-content/uploads/2024/01/ثشاهد-768x184.png 768w, https://help.irfarabi.com/wp-content/uploads/2024/01/ثشاهد-1536x368.png 1536w, https://help.irfarabi.com/wp-content/uploads/2024/01/ثشاهد-2048x491.png 2048w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" /></figure>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<p class=\"wp-block-paragraph\">سود سهامداران حقیقی که در سامانه سجام ثبت نام کرده‌اند به حساب فعال معرفی شده در سامانه سجام واریز می‌شود. سهامداران حقیقی غیرسجامی نیز لطفا در اسرع وقت جهت دریافت سود ثبت‌نام خود را در این سامانه تکمیل کنند.</p>\n\n\n\n<p class=\"wp-block-paragraph\">سود سهامداران حقیقی که اطلاعات و مشخصات ایشان در سجام ثبت نگردیده از تاریخ 1402/11/14 الی 1402/11/24 با دریافت نامه اعلام شماره حساب و شبای سهامدار پرداخت خواهد شد.</p>\n\n\n\n<p class=\"wp-block-paragraph\">آدرس: تهران خیابان مطهری انتهای خیابان کوه نور پلاک 22 &nbsp; &nbsp; تلفن:88735941 </p>\n\n\n\n<p class=\"wp-block-paragraph\">در صورتی که سجامی نیستید می‌توانید با مراجعه به لینک زیر ثبت نام خود را تکمیل کنید.</p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n<p><a style=\"background: #066137; color: #ffffff; font-size: 15px; padding: 10px 40px; border-radius: 5px; margin: 0 auto; display: table;\" href=\"https://account.irfarabi.com/reg/?j=1&#038;is=1\">تکمیل احراز هویت سجام</a></p>", "protected": false}, "categories": [35]}, {"id": 4917, "date": "2024-01-14T16:00:17", "modified": "2024-01-15T07:45:16", "slug": "%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b4%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%d8%af%d8%a7%d8%b3%d9%88%d9%87", "link": "https://help.irfarabi.com/%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b4%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%d8%af%d8%a7%d8%b3%d9%88%d9%87/%d8%a7%d8%ae%d8%a8%d8%a7%d8%b1/%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c/", "title": {"rendered": "زمانبندی پرداخت سود نقدی نماد داسوه"}, "content": {"rendered": "\n<p class=\"wp-block-paragraph\">پیرو اطلاعیه منتشر شده در سامانه <a href=\"https://www.codal.ir/\">کدال</a>، زمان‌بندی پرداخت سود شرکت <strong>داروسازی اسوه</strong> با نماد “داسوه” برای سال مالی منتهی به 1401/12/29 به شرح زیر است.</p>\n\n\n\n<p class=\"wp-block-paragraph\">سهامدارانی که در تاریخ 1402/02/27 سهامدار این نماد بوده و در مجمع عمومی عادی شرکت داشته‌اند مشمول دریافت <strong>3400 ریال</strong> سود نقدی هستند.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"228\" src=\"https://help.irfarabi.com/wp-content/uploads/2024/01/داسوه-1024x228.png\" alt=\"\" class=\"wp-image-4930\" srcset=\"https://help.irfarabi.com/wp-content/uploads/2024/01/داسوه-1024x228.png 1024w, https://help.irfarabi.com/wp-content/uploads/2024/01/داسوه-300x67.png 300w, https://help.irfarabi.com/wp-content/uploads/2024/01/داسوه-768x171.png 768w, https://help.irfarabi.com/wp-content/uploads/2024/01/داسوه-1536x343.png 1536w, https://help.irfarabi.com/wp-content/uploads/2024/01/داسوه-2048x457.png 2048w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" /></figure>\n\n\n\n<p class=\"wp-block-paragraph\">در صورتی که سجامی نیستید می‌توانید با مراجعه به لینک زیر ثبت نام خود را تکمیل کنید.</p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n<p><a style=\"background: #066137; color: #ffffff; font-size: 15px; padding: 10px 40px; border-radius: 5px; margin: 0 auto; display: table;\" href=\"https://account.irfarabi.com/reg/?j=1&#038;is=1\">تکمیل احراز هویت سجام</a></p>", "protected": false}, "categories": [35]}, {"id": 4902, "date": "2024-01-14T15:22:55", "modified": "2024-07-29T09:26:41", "slug": "%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%d8%af%da%a9%db%8c%d9%85%db%8c", "link": "https://help.irfarabi.com/%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%d8%af%da%a9%db%8c%d9%85%db%8c/%d8%a7%d8%ae%d8%a8%d8%a7%d8%b1/%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c/", "title": {"rendered": "زمانبندی پرداخت سود نقدی نماد دکیمی"}, "content": {"rendered": "\n<p class=\"wp-block-paragraph\">پیرو اطلاعیه منتشر شده در سامانه <a href=\"https://www.codal.ir/\">کدال</a>، زمان‌بندی پرداخت سود شرکت كيميدارو با نماد “دکیمی” برای سال مالی منتهی به 1402/09/30 به شرح زیر است.</p>\n\n\n\n<p class=\"wp-block-paragraph\">&nbsp;سهامدارانی که در تاریخ 1403/01/15 سهامدار این نماد بوده و در مجمع عمومی عادی شرکت داشته‌اند مشمول دریافت<strong> ۱,۵۰۰ ریال</strong> سود نقدی به ازای هر سهم&nbsp; هستند.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"222\" src=\"https://help.irfarabi.com/wp-content/uploads/2024/01/دکیمی-copy-1024x222.jpg\" alt=\"\" class=\"wp-image-8680\" srcset=\"https://help.irfarabi.com/wp-content/uploads/2024/01/دکیمی-copy-1024x222.jpg 1024w, https://help.irfarabi.com/wp-content/uploads/2024/01/دکیمی-copy-300x65.jpg 300w, https://help.irfarabi.com/wp-content/uploads/2024/01/دکیمی-copy-768x166.jpg 768w, https://help.irfarabi.com/wp-content/uploads/2024/01/دکیمی-copy-1536x333.jpg 1536w, https://help.irfarabi.com/wp-content/uploads/2024/01/دکیمی-copy-2048x444.jpg 2048w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" /></figure>\n\n\n\n<p class=\"wp-block-paragraph\"><br><strong>سود سهامداران حقیقی و حقوقی&nbsp; </strong>که در سامانه سجام ثبت نام کرده‌اند در تاریخ 1403/05/10 به حساب فعال معرفی شده در سامانه سجام واریز می‌شود.<br>سهامداران محترم می توانند با مراجعه به سایت <a href=\"http://www.chemidarou.com\">www.chemidarou.com</a> در پرتال، ثبت نام و از وضعیت سهام خود مطلع&nbsp; شوند.<br>شماره تلفن امور سهام: 77330291/77330299 داخلی 289،284(واحد سهام)<br>ایمیل: <a href=\"mailto:stock@chemidarou.com\">stock@chemidarou.com<br></a>شماره فکس واحد سهام: 77333942</p>\n\n\n<p><a style=\"background: #066137; color: #ffffff; font-size: 15px; padding: 10px 40px; border-radius: 5px; margin: 0 auto; display: table;\" href=\"https://account.irfarabi.com/reg/?j=1&#038;is=1\">تکمیل احراز هویت سجام</a></p>", "protected": false}, "categories": [35]}, {"id": 4908, "date": "2024-01-14T15:22:18", "modified": "2024-01-14T15:50:10", "slug": "%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%d8%af%d8%ac%d8%a7%d8%a8%d8%b1", "link": "https://help.irfarabi.com/%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%d8%af%d8%ac%d8%a7%d8%a8%d8%b1/%d8%a7%d8%ae%d8%a8%d8%a7%d8%b1/%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c/", "title": {"rendered": "زمانبندی پرداخت سود نقدی نماد دجابر"}, "content": {"rendered": "\n<p class=\"wp-block-paragraph\">پیرو اطلاعیه منتشر شده در سامانه <a href=\"https://www.codal.ir/\">کدال</a>، زمان‌بندی پرداخت سود شرکت داروسازي‌ جابرابن‌حيان‌ با نماد “دجابر” برای سال مالی منتهی به 1401/12/29 به شرح زیر است.</p>\n\n\n\n<p class=\"wp-block-paragraph\">سهامدارانی که در تاریخ 1402/03/04 سهامدار این نماد بوده و در مجمع عمومی عادی شرکت داشته‌اند مشمول دریافت <strong>1200ریال</strong> سود نقدی هستند.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"206\" src=\"https://help.irfarabi.com/wp-content/uploads/2024/01/دکیمی-1-1024x206.png\" alt=\"\" class=\"wp-image-4912\" srcset=\"https://help.irfarabi.com/wp-content/uploads/2024/01/دکیمی-1-1024x206.png 1024w, https://help.irfarabi.com/wp-content/uploads/2024/01/دکیمی-1-300x60.png 300w, https://help.irfarabi.com/wp-content/uploads/2024/01/دکیمی-1-768x155.png 768w, https://help.irfarabi.com/wp-content/uploads/2024/01/دکیمی-1-1536x309.png 1536w, https://help.irfarabi.com/wp-content/uploads/2024/01/دکیمی-1.png 2013w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" /></figure>\n\n\n\n<p class=\"wp-block-paragraph\">سود سهامداران حقیقی که در سامانه سجام ثبت نام کرده‌اند به حساب فعال معرفی شده در سامانه سجام واریز می‌شود. سهامداران حقیقی غیرسجامی نیز لطفا در اسرع وقت جهت دریافت سود ثبت‌نام خود را در این سامانه تکمیل کنند.</p>\n\n\n\n<p class=\"wp-block-paragraph\">تمامی سهامدارانی که شماره حساب اعلام ننموده اند می توانند به آدرس پرتال سهامداران در <strong><a href=\"http://www.jaber-pharma.com\" data-type=\"link\" data-id=\"www.jaber-pharma.com\">سایت شرکت</a> </strong>مراجعه و نسبت به ثبت نام و تکمیل اطلاعات هویتی و اطلاعات حساب بانکی(شماره شبا الزامی) خود اقدام نمایند.</p>\n\n\n\n<p class=\"wp-block-paragraph\"> در غیر این صورت فرم پیوست شده در سامانه کدال را تکمیل به طرق زیر به امور سهام شرکت تحویل نمایید:</p>\n\n\n\n<p class=\"wp-block-paragraph\">1- ارسال به آدرس کیلومتر 5 جاده مخصوص کرج-صندوق پستی 173913185 </p>\n\n\n\n<p class=\"wp-block-paragraph\"> 2- مراجعه به امور سهام واقع در شرکت </p>\n\n\n\n<p class=\"wp-block-paragraph\">3- ارسال فکس به شماره 44503524 </p>\n\n\n\n<p class=\"wp-block-paragraph\"><br>در صورتی که سجامی نیستید می‌توانید با مراجعه به لینک زیر ثبت نام خود را تکمیل کنید.</p>\n\n\n<p><a style=\"background: #066137; color: #ffffff; font-size: 15px; padding: 10px 40px; border-radius: 5px; margin: 0 auto; display: table;\" href=\"https://account.irfarabi.com/reg/?j=1&#038;is=1\">تکمیل احراز هویت سجام</a></p>", "protected": false}, "categories": [35]}, {"id": 4893, "date": "2024-01-14T15:21:27", "modified": "2024-01-14T15:50:15", "slug": "%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%d9%88%d8%a7%d9%84%d8%a8%d8%b1", "link": "https://help.irfarabi.com/%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%d9%88%d8%a7%d9%84%d8%a8%d8%b1/%d8%a7%d8%ae%d8%a8%d8%a7%d8%b1/%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c/", "title": {"rendered": "زمانبندی پرداخت سود نقدی نماد والبر"}, "content": {"rendered": "\n<p class=\"wp-block-paragraph\">پیرو اطلاعیه منتشر شده در سامانه <a href=\"https://www.codal.ir/\">کدال</a>، زمان‌بندی پرداخت سود شرکت گروه دارویی البرز(گروه سرمایه گذاری البرز) با نماد “والبر” برای سال مالی منتهی به 1401/12/29 به شرح زیر است.</p>\n\n\n\n<p class=\"wp-block-paragraph\">سهامدارانی که در تاریخ 1402/03/31 سهامدار این نماد بوده و در مجمع عمومی عادی شرکت داشته‌اند مشمول دریافت <strong>530 ریال</strong> سود نقدی هستند.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"238\" src=\"https://help.irfarabi.com/wp-content/uploads/2024/01/والبر-1-1024x238.png\" alt=\"\" class=\"wp-image-4922\" srcset=\"https://help.irfarabi.com/wp-content/uploads/2024/01/والبر-1-1024x238.png 1024w, https://help.irfarabi.com/wp-content/uploads/2024/01/والبر-1-300x70.png 300w, https://help.irfarabi.com/wp-content/uploads/2024/01/والبر-1-768x178.png 768w, https://help.irfarabi.com/wp-content/uploads/2024/01/والبر-1-1536x357.png 1536w, https://help.irfarabi.com/wp-content/uploads/2024/01/والبر-1-2048x476.png 2048w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" /></figure>\n\n\n\n<p class=\"wp-block-paragraph\">سود سهامداران حقیقی که در سامانه سجام ثبت نام کرده‌اند به حساب فعال معرفی شده در سامانه سجام واریز می‌شود. سهامداران حقیقی غیرسجامی نیز لطفا در اسرع وقت جهت دریافت سود ثبت‌نام خود را در این سامانه تکمیل کنند.</p>\n\n\n\n<p class=\"wp-block-paragraph\">سود سهامداران حقیقی که اطلاعات و مشخصات ایشان در سجام ثبت نشده بعد از تاریخ اعلام شده از طریق مراجعه حضوری به هر یک از شعب بانک پارسیان در سراسر کشور و با ارائه کارت ملی قابل دریافت است.</p>\n\n\n\n<p class=\"wp-block-paragraph\">در صورتی که سجامی نیستید می‌توانید با مراجعه به لینک زیر ثبت نام خود را تکمیل کنید.</p>\n\n\n<p><a style=\"background: #066137; color: #ffffff; font-size: 15px; padding: 10px 40px; border-radius: 5px; margin: 0 auto; display: table;\" href=\"https://account.irfarabi.com/reg/?j=1&#038;is=1\">تکمیل احراز هویت سجام</a></p>", "protected": false}, "categories": [35]}, {"id": 4731, "date": "2024-01-08T11:48:29", "modified": "2024-01-08T11:48:29", "slug": "%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%d8%ba%d8%a7%d8%b0%d8%b1", "link": "https://help.irfarabi.com/%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%d8%ba%d8%a7%d8%b0%d8%b1/%d8%a7%d8%ae%d8%a8%d8%a7%d8%b1/%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c/", "title": {"rendered": "زمانبندی پرداخت سود نقدی نماد غاذر"}, "content": {"rendered": "\n<p class=\"wp-block-paragraph\">پیرو اطلاعیه منتشر شده در سامانه <a href=\"https://codal.ir/ReportList.aspx?search&amp;Symbol=%D8%BA%D8%A7%D8%B0%D8%B1&amp;LetterType=-1&amp;Isic=421303&amp;AuditorRef=-1&amp;PageNumber=1&amp;Audited&amp;NotAudited&amp;IsNotAudited=false&amp;Childs&amp;Mains&amp;Publisher=false&amp;CompanyState=0&amp;Category=-1&amp;CompanyType=1&amp;Consolidatable&amp;NotConsolidatable\" data-type=\"link\" data-id=\"https://codal.ir/ReportList.aspx?search&amp;Symbol=%D8%BA%D8%A7%D8%B0%D8%B1&amp;LetterType=-1&amp;Isic=421303&amp;AuditorRef=-1&amp;PageNumber=1&amp;Audited&amp;NotAudited&amp;IsNotAudited=false&amp;Childs&amp;Mains&amp;Publisher=false&amp;CompanyState=0&amp;Category=-1&amp;CompanyType=1&amp;Consolidatable&amp;NotConsolidatable\"><strong>کدال</strong></a>، زمان‌بندی پرداخت سود شرکت کشت و صنعت پیاذر با نماد “غاذر” برای سال مالی منتهی به 1402/12/29 به شرح زیر است.</p>\n\n\n\n<p class=\"wp-block-paragraph\">سهامدارانی که در تاریخ 1402/05/15 سهامدار این نماد بوده و در مجمع عمومی عادی شرکت داشته‌اند مشمول دریافت <strong>400 ریال</strong> سود نقدی هستند.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"226\" src=\"https://help.irfarabi.com/wp-content/uploads/2024/01/سود-نقدی-غاذر-1024x226.png\" alt=\"\" class=\"wp-image-4738\" srcset=\"https://help.irfarabi.com/wp-content/uploads/2024/01/سود-نقدی-غاذر-1024x226.png 1024w, https://help.irfarabi.com/wp-content/uploads/2024/01/سود-نقدی-غاذر-300x66.png 300w, https://help.irfarabi.com/wp-content/uploads/2024/01/سود-نقدی-غاذر-768x169.png 768w, https://help.irfarabi.com/wp-content/uploads/2024/01/سود-نقدی-غاذر-1536x339.png 1536w, https://help.irfarabi.com/wp-content/uploads/2024/01/سود-نقدی-غاذر-2048x452.png 2048w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" /></figure>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<p class=\"wp-block-paragraph\">سود سهامداران حقیقی که در سامانه سجام ثبت نام کرده‌اند به حساب فعال معرفی شده در سامانه سجام واریز می‌شود. سهامداران حقیقی غیرسجامی نیز لطفا در اسرع وقت جهت دریافت سود ثبت‌نام خود را در این سامانه تکمیل کنند.</p>\n\n\n\n<p class=\"wp-block-paragraph\">در صورتی که سجامی نیستید می‌توانید با مراجعه به لینک زیر ثبت نام خود را تکمیل کنید.</p>\n\n\n<p><a style=\"background: #066137; color: #ffffff; font-size: 15px; padding: 10px 40px; border-radius: 5px; margin: 0 auto; display: table;\" href=\"https://account.irfarabi.com/reg/?j=1&#038;is=1\">تکمیل احراز هویت سجام</a></p>\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<p class=\"wp-block-paragraph\">سهامداران حقیقی، حقوقی، صندوق ها و سبدهای سرمایه گذاری غیر سجامی جهت دریافت سود سهام می توانند مشخصات کامل خود شامل رونوشت کارت ملی و صفحه اول شناسنامه، آدرس تلفن و مشخصات کامل حساب بانکی و شماره شبا را به شماره 04132455834 فکس و یا به آدرس ایمیل info@piazar.com ارسال نمایند. </p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n", "protected": false}, "categories": [35]}, {"id": 4740, "date": "2024-01-08T11:34:06", "modified": "2024-01-08T11:50:39", "slug": "%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%da%a9%d9%81%d8%b1%d8%a2%d9%88%d8%b1", "link": "https://help.irfarabi.com/%d8%b2%d9%85%d8%a7%d9%86%d8%a8%d9%86%d8%af%db%8c-%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa-%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c-%d9%86%d9%85%d8%a7%d8%af-%da%a9%d9%81%d8%b1%d8%a2%d9%88%d8%b1/%d8%a7%d8%ae%d8%a8%d8%a7%d8%b1/%d8%b3%d9%88%d8%af-%d9%86%d9%82%d8%af%db%8c/", "title": {"rendered": "زمانبندی پرداخت سود نقدی نماد کفرآور"}, "content": {"rendered": "\n<p class=\"wp-block-paragraph\">پیرو اطلاعیه منتشر شده در سامانه <a href=\"https://codal.ir/ReportList.aspx?search&amp;Symbol=%DA%A9%D9%81%D8%B1%D8%A2%D9%88%D8%B1&amp;LetterType=-1&amp;Isic=549504&amp;AuditorRef=-1&amp;PageNumber=1&amp;Audited&amp;NotAudited&amp;IsNotAudited=false&amp;Childs&amp;Mains&amp;Publisher=false&amp;CompanyState=2&amp;Category=-1&amp;CompanyType=1&amp;Consolidatable&amp;NotConsolidatable\" data-type=\"link\" data-id=\"https://codal.ir/ReportList.aspx?search&amp;Symbol=%DA%A9%D9%81%D8%B1%D8%A2%D9%88%D8%B1&amp;LetterType=-1&amp;Isic=549504&amp;AuditorRef=-1&amp;PageNumber=1&amp;Audited&amp;NotAudited&amp;IsNotAudited=false&amp;Childs&amp;Mains&amp;Publisher=false&amp;CompanyState=2&amp;Category=-1&amp;CompanyType=1&amp;Consolidatable&amp;NotConsolidatable\"><strong>کدال</strong></a>، زمان‌بندی پرداخت سود شرکت فرآورده های سیمان شرق با نماد “کفرآور” برای سال مالی منتهی به 1402/05/31 به شرح زیر است.</p>\n\n\n\n<p class=\"wp-block-paragraph\">سهامدارانی که در تاریخ 1402/07/19 سهامدار این نماد بوده و در مجمع عمومی عادی شرکت داشته‌اند مشمول دریافت<strong> 1500 ریال</strong> سود نقدی به ازای هر سهم هستند.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"411\" src=\"https://help.irfarabi.com/wp-content/uploads/2024/01/سود-نقدی-کفرآور-4-1024x411.png\" alt=\"\" class=\"wp-image-4760\